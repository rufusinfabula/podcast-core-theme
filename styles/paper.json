{
  "$schema": "https://schemas.wp.org/wp/6.7/theme.json",
  "version": 3,
  "title": "Paper",
  "settings": {
    "color": {
      "palette": [
        { "slug": "base", "name": "Base", "color": "#FBF7F0" },
        { "slug": "surface", "name": "Surface", "color": "#F1EADC" },
        { "slug": "contrast", "name": "Contrast", "color": "#2B2420" },
        { "slug": "muted", "name": "Muted", "color": "#6F655C" },
        { "slug": "primary", "name": "Primary", "color": "#9C3D2E" },
        { "slug": "secondary", "name": "Secondary", "color": "#EAD9C6" },
        { "slug": "accent", "name": "Accent", "color": "#2F6B5E" }
      ]
    },
    "typography": {
      "fontFamilies": [
        { "slug": "body", "name": "Body", "fontFamily": "Charter, \"Bitstream Charter\", \"Sitka Text\", Cambria, Georgia, serif" },
        { "slug": "heading", "name": "Headings", "fontFamily": "Charter, \"Bitstream Charter\", \"Sitka Text\", Cambria, Georgia, serif" },
        { "slug": "mono", "name": "Monospace", "fontFamily": "ui-monospace, SFMono-Regular, Menlo, Consolas, monospace" }
      ]
    }
  },
  "styles": {
    "typography": { "lineHeight": "1.7" },
    "elements": {
      "heading": { "typography": { "fontWeight": "700", "letterSpacing": "-0.01em" } },
      "button": { "border": { "radius": "4px" } }
    }
  }
}
