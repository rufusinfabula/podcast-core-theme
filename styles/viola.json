{
  "$schema": "https://schemas.wp.org/wp/6.7/theme.json",
  "version": 3,
  "title": "Viola",
  "settings": {
    "color": {
      "palette": [
        {
          "slug": "base",
          "name": "Base",
          "color": "#FFFFFF"
        },
        {
          "slug": "surface",
          "name": "Surface",
          "color": "#FFF0F7"
        },
        {
          "slug": "contrast",
          "name": "Contrast",
          "color": "#1A0B2E"
        },
        {
          "slug": "muted",
          "name": "Muted",
          "color": "#5B4B73"
        },
        {
          "slug": "primary",
          "name": "Primary",
          "color": "#7B2FF7"
        },
        {
          "slug": "secondary",
          "name": "Secondary",
          "color": "#FFE45E"
        },
        {
          "slug": "accent",
          "name": "Accent",
          "color": "#FF2D87"
        }
      ]
    },
    "custom": {
      "hero": {
        "buttonBackground": "var(--wp--preset--color--secondary)",
        "buttonText": "var(--wp--preset--color--contrast)",
        "buttonHoverBackground": "var(--wp--preset--color--accent)",
        "buttonHoverText": "var(--wp--preset--color--base)"
      }
    }
  },
  "styles": {
    "elements": {
      "heading": {
        "typography": {
          "fontWeight": "900",
          "letterSpacing": "-0.02em"
        }
      },
      "button": {
        ":hover": {
          "color": {
            "background": "var:preset|color|accent",
            "text": "var:preset|color|base"
          }
        }
      }
    }
  }
}
