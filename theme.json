{
  "$schema": "https://schemas.wp.org/wp/6.7/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "useRootPaddingAwareAlignments": true,
    "layout": {
      "contentSize": "760px",
      "wideSize": "1280px"
    },
    "color": {
      "defaultPalette": false,
      "defaultGradients": false,
      "defaultDuotone": false,
      "palette": [
        {
          "slug": "base",
          "name": "Base",
          "color": "#FFFFFF"
        },
        {
          "slug": "surface",
          "name": "Surface",
          "color": "#F4F5F7"
        },
        {
          "slug": "contrast",
          "name": "Contrast",
          "color": "#16181D"
        },
        {
          "slug": "muted",
          "name": "Muted",
          "color": "#5E6470"
        },
        {
          "slug": "primary",
          "name": "Primary",
          "color": "#3D3DD9"
        },
        {
          "slug": "secondary",
          "name": "Secondary",
          "color": "#E3E3FA"
        },
        {
          "slug": "accent",
          "name": "Accent",
          "color": "#FF6B4A"
        }
      ]
    },
    "typography": {
      "defaultFontSizes": false,
      "fluid": true,
      "fontFamilies": [
        {
          "slug": "body",
          "name": "Body",
          "fontFamily": "-apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, \"Helvetica Neue\", Arial, sans-serif"
        },
        {
          "slug": "heading",
          "name": "Headings",
          "fontFamily": "-apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, \"Helvetica Neue\", Arial, sans-serif"
        },
        {
          "slug": "mono",
          "name": "Monospace",
          "fontFamily": "ui-monospace, SFMono-Regular, Menlo, Consolas, monospace"
        }
      ],
      "fontSizes": [
        {
          "slug": "small",
          "name": "Small",
          "size": "0.875rem",
          "fluid": false
        },
        {
          "slug": "medium",
          "name": "Medium",
          "size": "1.0625rem",
          "fluid": {
            "min": "1rem",
            "max": "1.125rem"
          }
        },
        {
          "slug": "large",
          "name": "Large",
          "size": "1.375rem",
          "fluid": {
            "min": "1.125rem",
            "max": "1.375rem"
          }
        },
        {
          "slug": "x-large",
          "name": "Extra Large",
          "size": "2rem",
          "fluid": {
            "min": "1.6rem",
            "max": "2rem"
          }
        },
        {
          "slug": "xx-large",
          "name": "Huge",
          "size": "3rem",
          "fluid": {
            "min": "2.2rem",
            "max": "3.25rem"
          }
        }
      ]
    },
    "spacing": {
      "defaultSpacingSizes": false,
      "spacingSizes": [
        {
          "slug": "20",
          "name": "2X-Small",
          "size": "0.5rem"
        },
        {
          "slug": "30",
          "name": "X-Small",
          "size": "1rem"
        },
        {
          "slug": "40",
          "name": "Small",
          "size": "1.5rem"
        },
        {
          "slug": "50",
          "name": "Medium",
          "size": "clamp(1.5rem, 4vw, 2.5rem)"
        },
        {
          "slug": "60",
          "name": "Large",
          "size": "clamp(2rem, 6vw, 4rem)"
        },
        {
          "slug": "70",
          "name": "X-Large",
          "size": "clamp(3rem, 8vw, 6rem)"
        }
      ]
    },
    "custom": {
      "onPrimary": "var(--wp--preset--color--base)",
      "onAccent": "var(--wp--preset--color--contrast)"
    }
  },
  "styles": {
    "color": {
      "background": "var:preset|color|base",
      "text": "var:preset|color|contrast"
    },
    "spacing": {
      "blockGap": "1.25rem",
      "padding": {
        "left": "var:preset|spacing|50",
        "right": "var:preset|spacing|50"
      }
    },
    "typography": {
      "fontFamily": "var:preset|font-family|body",
      "fontSize": "var:preset|font-size|medium",
      "lineHeight": "1.6"
    },
    "elements": {
      "heading": {
        "color": {
          "text": "var:preset|color|contrast"
        },
        "typography": {
          "fontFamily": "var:preset|font-family|heading",
          "fontWeight": "800",
          "lineHeight": "1.15"
        }
      },
      "h1": {
        "typography": {
          "fontSize": "var:preset|font-size|xx-large"
        }
      },
      "h2": {
        "typography": {
          "fontSize": "var:preset|font-size|x-large"
        }
      },
      "h3": {
        "typography": {
          "fontSize": "var:preset|font-size|large"
        }
      },
      "h4": {
        "typography": {
          "fontSize": "var:preset|font-size|medium"
        }
      },
      "link": {
        "color": {
          "text": "var:preset|color|primary"
        },
        ":hover": {
          "typography": {
            "textDecoration": "none"
          }
        }
      },
      "button": {
        "color": {
          "background": "var:preset|color|primary",
          "text": "var:preset|color|base"
        },
        "border": {
          "radius": "999px"
        },
        "spacing": {
          "padding": {
            "top": "0.75rem",
            "bottom": "0.75rem",
            "left": "1.5rem",
            "right": "1.5rem"
          }
        },
        "typography": {
          "fontWeight": "700",
          "fontSize": "var:preset|font-size|small"
        },
        ":hover": {
          "color": {
            "background": "var:preset|color|contrast",
            "text": "var:preset|color|base"
          }
        },
        ":focus": {
          "outline": {
            "color": "var:preset|color|accent",
            "offset": "2px",
            "style": "solid",
            "width": "2px"
          }
        }
      },
      "caption": {
        "color": {
          "text": "var:preset|color|muted"
        },
        "typography": {
          "fontSize": "var:preset|font-size|small"
        }
      }
    },
    "blocks": {
      "core/navigation": {
        "typography": {
          "fontWeight": "600",
          "fontSize": "var:preset|font-size|small"
        }
      },
      "core/post-date": {
        "color": {
          "text": "var:preset|color|muted"
        },
        "typography": {
          "fontSize": "var:preset|font-size|small"
        }
      },
      "core/post-terms": {
        "typography": {
          "fontSize": "var:preset|font-size|small",
          "fontWeight": "600"
        }
      },
      "core/post-featured-image": {
        "border": {
          "radius": "8px"
        }
      },
      "core/separator": {
        "color": {
          "text": "var:preset|color|surface"
        }
      },
      "core/code": {
        "typography": {
          "fontFamily": "var:preset|font-family|mono"
        }
      },
      "podcast-core/episode-player": {
        "color": {
          "background": "var:preset|color|contrast",
          "text": "var:preset|color|base"
        },
        "spacing": {
          "padding": {
            "top": "0",
            "bottom": "0",
            "left": "0",
            "right": "0"
          }
        },
        "border": {
          "radius": "0px"
        }
      }
    }
  },
  "templateParts": [
    {
      "name": "header",
      "title": "Header",
      "area": "header"
    },
    {
      "name": "footer",
      "title": "Footer",
      "area": "footer"
    }
  ],
  "customTemplates": [
    {
      "name": "page-no-title",
      "title": "Page without title",
      "postTypes": [
        "page"
      ]
    }
  ]
}
