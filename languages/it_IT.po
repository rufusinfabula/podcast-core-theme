msgstr ""

#. Description of the theme
#: style.css
msgid "A block theme for podcast websites. Designed to work with Podcast Core Plugin: episode pages, audio player, series archives and grouped search."
msgstr "Un tema a blocchi per siti di podcast. Pensato per Podcast Core Plugin: pagine degli episodi, player audio, archivi delle serie e ricerca raggruppata."

#. Author of the theme
#: style.css
msgid "Rufusinfabula"
msgstr ""

#: functions.php:52
msgid "Podcast"
msgstr "Podcast"

#: functions.php:127
msgid "Highlighted line"
msgstr "Riga evidenziata"

#: patterns/cta-episode-highlight.php
msgctxt "Pattern title"
msgid "Special episode"
msgstr "Puntata speciale"

#: patterns/cta-episode-highlight.php
msgctxt "Pattern description"
msgid "One episode in the spotlight with cover, title, excerpt and a listen button. By default the latest episode of a series; change the filter to pick another one."
msgstr "Un episodio in evidenza con copertina, titolo, estratto e pulsante di ascolto. Di default l'ultimo episodio di una serie: cambia il filtro per sceglierne un altro."

#: patterns/cta-episode-highlight.php:45
msgid "Special episode"
msgstr "Puntata speciale"

#: patterns/cta-episode-highlight.php:50
msgid "Listen now →"
msgstr "Ascolta ora →"

#: patterns/cta-series-banner.php
msgctxt "Pattern title"
msgid "Special series banner"
msgstr "Banner serie speciale"

#: patterns/cta-series-banner.php
msgctxt "Pattern description"
msgid "Full-width banner promoting a special series, with a button to its archive."
msgstr "Banner a tutta larghezza per promuovere una serie speciale, con pulsante verso il suo archivio."

#: patterns/cta-series-banner.php:14
#: patterns/cta-series-episodes.php:17
msgid "Series name"
msgstr "Nome della serie"

#: patterns/cta-series-banner.php:23
msgid "Special series"
msgstr "Serie speciale"

#: patterns/cta-series-banner.php:31
msgid "A short series that goes deeper into one theme, episode after episode. Tell listeners why it is worth their time."
msgstr "Una serie breve che approfondisce un tema, episodio dopo episodio. Racconta perché vale la pena ascoltarla."

#: patterns/cta-series-banner.php:37
msgid "Listen to the series"
msgstr "Ascolta la serie"

#: patterns/cta-series-episodes.php
msgctxt "Pattern title"
msgid "Series spotlight with episodes"
msgstr "Serie in evidenza con episodi"

#: patterns/cta-series-episodes.php
msgctxt "Pattern description"
msgid "Introduces a series and lists its latest episodes, with a button to the series archive."
msgstr "Presenta una serie e ne elenca gli ultimi episodi, con un pulsante verso l'archivio della serie."

#: patterns/cta-series-episodes.php:38
msgid "Series"
msgstr "Serie"

#: patterns/cta-series-episodes.php:46
msgid "Describe the series in one or two sentences: who you talk to and what listeners will discover."
msgstr "Descrivi la serie in una o due frasi: con chi parli e cosa scoprirà chi ascolta."

#: patterns/cta-series-episodes.php:52
msgid "All episodes of the series"
msgstr "Tutti gli episodi della serie"

#: patterns/cta-series-episodes.php:77
msgid "No episodes in this series yet."
msgstr "Ancora nessun episodio in questa serie."

#: patterns/cta-series-grid.php
msgctxt "Pattern title"
msgid "All series"
msgstr "Tutte le serie"

#: patterns/cta-series-grid.php
msgctxt "Pattern description"
msgid "One card per series with description, number of episodes and a link to its archive. Cards are created from the series that exist when the pattern is inserted."
msgstr "Una scheda per serie con descrizione, numero di episodi e link all'archivio. Le schede vengono create dalle serie esistenti al momento dell'inserimento."

#: patterns/cta-series-grid.php:30
msgid "Our series"
msgstr "Le nostre serie"

#: patterns/cta-series-grid.php:43
msgid "Add a short description of this series."
msgstr "Aggiungi una breve descrizione di questa serie."

#. translators: %s: number of episodes
#: patterns/cta-series-grid.php:50
#, php-format
msgid "%s episode"
msgid_plural "%s episodes"
msgstr[0] "%s episodio"
msgstr[1] "%s episodi"

#: patterns/cta-series-grid.php:58
msgid "Listen"
msgstr "Ascolta"

#: patterns/footer-credit.php
msgctxt "Pattern title"
msgid "Footer credit"
msgstr "Crediti del footer"

#: patterns/footer-platforms.php
msgctxt "Pattern title"
msgid "Footer platform icons"
msgstr "Icone piattaforme nel footer"

#: patterns/hero.php
msgctxt "Pattern title"
msgid "Hero"
msgstr "Hero"

#: patterns/hero.php
msgctxt "Pattern description"
msgid "Tagline on coloured lines (Highlighted line style), subtitle, platform buttons and one or more images. Add several images to get a crossfade slideshow."
msgstr "Slogan su righe colorate (stile Riga evidenziata), sottotitolo, pulsanti delle piattaforme e una o più immagini. Con più immagini si ottiene una dissolvenza a rotazione."

#: patterns/hero.php:24
msgid "Real stories,"
msgstr "Storie vere,"

#: patterns/hero.php:28
msgid "real people,"
msgstr "persone vere,"

#: patterns/hero.php:32
msgid "every week."
msgstr "ogni settimana."

#: patterns/hero.php:38
msgid "The podcast that tells the people behind the stories."
msgstr "Il podcast che racconta le persone dietro le storie."

#: patterns/homepage.php
msgctxt "Pattern title"
msgid "Homepage"
msgstr "Homepage"

#: patterns/homepage.php
msgctxt "Pattern description"
msgid "A complete home page: hero, latest episodes and latest news. Use it as the starting point of the page set as homepage in Settings → Reading."
msgstr "Una homepage completa: hero, ultimi episodi e ultime news. Usala come punto di partenza per la pagina impostata come homepage in Impostazioni → Lettura."

#: patterns/latest-episodes.php
msgctxt "Pattern title"
msgid "Latest episodes"
msgstr "Ultimi episodi"

#: patterns/latest-episodes.php
msgctxt "Pattern description"
msgid "The three most recent episodes with a link to the archive."
msgstr "I tre episodi più recenti con il link all'archivio."

#: patterns/latest-episodes.php:21
msgid "Latest episodes"
msgstr "Ultimi episodi"

#: patterns/latest-episodes.php:25
msgid "All episodes →"
msgstr "Tutti gli episodi →"

#: patterns/latest-episodes.php:47
msgid "No episodes published yet."
msgstr "Nessun episodio pubblicato per ora."

#: patterns/latest-posts.php
msgctxt "Pattern title"
msgid "Latest news"
msgstr "Ultime news"

#: patterns/latest-posts.php
msgctxt "Pattern description"
msgid "The three most recent blog posts."
msgstr "I tre articoli più recenti."

#: patterns/latest-posts.php:16
msgid "Latest news"
msgstr "Ultime news"

#: patterns/latest-posts.php:33
msgid "No news published yet."
msgstr "Nessuna news pubblicata per ora."

#: patterns/newsletter.php
msgctxt "Pattern title"
msgid "Newsletter call to action"
msgstr "Invito alla newsletter"

#: patterns/newsletter.php
msgctxt "Pattern description"
msgid "A banner inviting visitors to subscribe to the newsletter."
msgstr "Un riquadro che invita a iscriversi alla newsletter."

#: patterns/newsletter.php:18
msgid "Get new episodes in your inbox"
msgstr "I nuovi episodi nella tua casella di posta"

#: patterns/newsletter.php:22
msgid "Subscribe to the newsletter: episodes, behind the scenes and stories."
msgstr "Iscriviti alla newsletter: episodi, retroscena e storie."

#: patterns/newsletter.php:30
msgid "Subscribe"
msgstr "Iscriviti"

#: patterns/platform-links.php
msgctxt "Pattern title"
msgid "Listen on"
msgstr "Ascolta su"

#: patterns/platform-links.php
msgctxt "Pattern description"
msgid "Buttons to the platforms set in Settings → Podcast (Podcast Core Plugin)."
msgstr "Pulsanti verso le piattaforme impostate in Impostazioni → Podcast (Podcast Core Plugin)."

